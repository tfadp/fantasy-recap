# secrets
.env
oauth2.json

# caches
cache/
__pycache__/
*.pyc

# The voice files hold real group chat. GitHub Pages on a free account needs a
# public repo, and your friends' messages do not belong on the public internet.
# These live only on your machine and, for the scheduled run, in an Actions
# secret. See README "Keeping the chat private".
prompts/*-chat.md
.draft-salt
approved.json.bak

# Handed-in weeks. payload.py takes the newest file here, so a committed one
# would be re-processed by every scheduled run long after its week is over.
# The week itself is preserved in history/<league>/ once it has been written.
inbox/*.json
