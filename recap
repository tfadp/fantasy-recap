#!/usr/bin/env python3
"""
The Tuesday morning front door.

    ./recap                       pull, write, publish a draft, email it to you
    ./recap approve mop           approve MOP's newest week -> public URL + archive
    ./recap approve yahoo 2026-wk03
                                  approve one league's specific week
    ./recap redo --only yahoo --note "..."
                                  rewrite a league's newest week, steered
    ./recap facts --week 3        numbers only, no model call, nothing published
    ./recap link                  print each league's link for its newest week

Each league has its own page and its own link. Approving one never touches
the other.

Everything it does is also reachable through run.py / publish.py / deliver.py.
This just spares you remembering which is which at 9am.
"""

import glob
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

import env  # noqa: E402
import publish  # noqa: E402

PY = sys.executable or "python3"


def sh(*args):
    r = subprocess.run([PY] + list(args), cwd=HERE)
    if r.returncode:
        sys.exit(r.returncode)


def enabled():
    return [c["name"] for c in json.load(open(os.path.join(HERE, "leagues.json")))["leagues"]
            if c.get("enabled")]


def main():
    env.load()
    argv = sys.argv[1:]
    cmd = argv[0] if argv and not argv[0].startswith("-") else "run"
    rest = argv[1:] if cmd != "run" else argv

    if cmd == "run":
        sh("run.py", *rest)
        sh("publish.py")
        sh("deliver.py")

    elif cmd == "redo":
        sh("run.py", *rest)
        sh("publish.py")
        sh("deliver.py")

    elif cmd == "approve":
        if not rest or rest[0] not in enabled():
            sys.exit(f"Which league? ./recap approve <{'|'.join(enabled())}> [week]")
        league = rest[0]
        stem = rest[1] if len(rest) > 1 else publish.newest(league)
        publish.promote(league, stem)
        link = os.environ.get("PAGES_URL", "").rstrip("/")
        print(f"\nSend this to the {league} thread:\n{link}/{publish.page_path(league, stem)}"
              if link else f"\nApproved {league} {stem}. Set PAGES_URL in .env to get the link printed.")

    elif cmd == "facts":
        sh("run.py", "--no-write", *rest)

    elif cmd == "link":
        import deliver
        for league in enabled():
            if league not in publish.collect():
                continue
            stem = publish.newest(league)
            url, public = deliver.page_link(league, stem)
            print(f"{league} {stem}: {url or 'Set PAGES_URL in .env'}"
                  + ("" if public else "  (draft)"))

    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
