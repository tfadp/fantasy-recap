# Copy to .env and fill in. .env is gitignored.
# Real environment variables win over this file, so the same code runs
# unchanged under GitHub Actions where these arrive as secrets.

# Writes the recap. Without it you still get every number, just no prose.
ANTHROPIC_API_KEY=

# Emails you the draft Tuesday morning. https://resend.com, free tier is plenty.
RESEND_API_KEY=
RECAP_EMAIL_TO=

# Where the published pages live. Set after you turn on GitHub Pages.
PAGES_URL=https://tfadp.github.io/fantasy-recap

# Optional. Overrides the default model.
# RECAP_MODEL=claude-opus-5

# Optional. Only if a league is on GroupMe; iMessage cannot be posted to.
# GROUPME_BOT_ID=
